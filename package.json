{
  "name": "nxcloud",
  "version": "0.6.0",
  "description": "Local Node.js server manager with Cloudflare Tunnel",
  "type": "module",
  "bin": {
    "nxcloud": "./bin/nxcloud.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "cli": "node bin/nxcloud.js",
    "link": "npm link",
    "unlink": "npm unlink -g nxcloud",
    "test": "node --test tests/*.test.js",
    "build:exe": "node scripts/build-exe.mjs",
    "build:exe:linux": "node scripts/build-exe-linux.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cloudflare",
    "tunnel",
    "cloudflared",
    "local-server",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
